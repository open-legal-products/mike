{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["./node_modules/@types"],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@sentry/react": ["./node_modules/@sentry/react"],
      "@mike/contracts": ["../packages/contracts/index.d.ts"],
      "@/*": ["./src/*"],
      "@mike/upload-session-client": ["./src/shared/api/uploadSessionClient.ts"],
      "@mike/secure-uuid": ["./src/shared/lib/secureUuid.ts"],
      "@mike/sentry-event": ["./src/shared/lib/sentryEvent.ts"],
      "@mike/user-error": ["./src/shared/lib/userError.ts"],
      "@mike/toast-store": ["./src/shared/lib/toastStore.ts"],
      "@mike/toast-ui": ["./src/shared/ui/ToastUI.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
