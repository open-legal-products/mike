{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["./node_modules/@types"],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@sentry/react": ["./node_modules/@sentry/react"],
      "@/*": ["./src/*"],
      // Shared packages (packages/*), reached by name. frontend/Dockerfile
      // copies each target into the image at the path the alias resolves to;
      // src/__tests__/architecture.test.ts checks the two agree.
      "@mike/contracts": ["../packages/contracts/index.d.ts"],
      "@mike/ui": ["../packages/ui/src/index.ts"],
      "@mike/client": ["../packages/client/src/index.ts"],
      // The packages have no node_modules of their own: their dependencies
      // are this application's. Node-style lookup from packages/ walks up to
      // the repository root and never reaches frontend/node_modules, so name
      // each dependency a package imports here. Keep the list in step with
      // packages/*/package.json peerDependencies (and the test tooling the
      // packages' colocated tests use).
      //
      // react, react/jsx-runtime and react-dom are deliberately absent.
      // Turbopack applies these paths at runtime, not only to types, and
      // their only type-checkable targets are @types declaration files with
      // no runtime exports: mapping react/jsx-runtime to one compiled every
      // JSX call to `(void 0)(...)`. Next's import map supplies the runtime
      // copies and `typeRoots` above supplies their types, for files under
      // packages/ too.
      "lucide-react": ["./node_modules/lucide-react"],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "@radix-ui/react-dropdown-menu": ["./node_modules/@radix-ui/react-dropdown-menu"],
      "vitest": ["./node_modules/vitest"],
      "@testing-library/react": ["./node_modules/@testing-library/react"],
      "@testing-library/user-event": ["./node_modules/@testing-library/user-event"],
      "postcss": ["./node_modules/postcss"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    // The shared packages are part of this program: `next build` type-checks
    // what it bundles, and `npm run typecheck` covers their colocated tests.
    "../packages/ui/src/**/*.ts",
    "../packages/ui/src/**/*.tsx",
    "../packages/ui/stories/*.tsx",
    "../packages/client/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
