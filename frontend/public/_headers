# Build-hashed assets are immutable; public files without hashes must revalidate.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare serves these files before the Next server runs, so the headers in
# next.config.ts (src/app/lib/securityHeaders.ts) never reach them. Keep these
# values equal to the production ones there; securityHeaders.test.ts checks.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=15552000; includeSubDomains
