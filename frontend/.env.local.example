# Server-only upstream used by the same-origin /api gateway.
API_BASE_URL=http://localhost:3001

# Sentry error tracking is ON BY DEFAULT and goes to the Mike project's own
# Sentry (README "Telemetry", docs/observability.md): never document text,
# bodies, cookies, auth headers or emails; community installs also drop
# machine names, user ids, headers, breadcrumbs and file paths. NEXT_PUBLIC_*
# values are inlined into the browser bundle at build time; the SENTRY_*
# ones are read by the Next server at runtime. Set SENTRY_DISABLED=true to
# stop server and browser forwarding, or SENTRY_DSN to use your own project.
# NEXT_PUBLIC_SENTRY_DISABLED/DSN are defaults for the server/tunnel when
# the matching runtime setting is empty; the browser SDK always uses the tunnel.
NEXT_PUBLIC_SENTRY_DISABLED=false
NEXT_PUBLIC_SENTRY_INSTALL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DISABLED=false
SENTRY_INSTALL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source-map upload for readable production stack traces; all three required.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
