NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Browser-reachable frontend gateway used for OAuth callbacks, including MCP
# connectors. In production this must be HTTPS and include the `/api` prefix.
API_PUBLIC_URL=http://localhost:3000/api
# Public task-pane origin for deployed Word add-ins. Local development uses the
# same-origin webpack proxy and does not need this entry.
WORD_ADDIN_URL=
# Required when WORD_ADDIN_URL is set. Generate with: openssl rand -hex 32
# This encrypts the short-lived, single-use OAuth handoff stored in Postgres.
AUTH_HANDOFF_ENCRYPTION_SECRET=
# Defaults to 120 seconds and is constrained to 30-300 seconds.
AUTH_HANDOFF_TTL_SECONDS=120
# Optional comma-separated origins for additional trusted clients.
ALLOWED_ORIGINS=

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
# Public/anon key used by the backend's per-request user-session client. It is
# server-side here; the service-role key is never used for browser sessions.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Authentication-specific throttles. Successful logins do not consume the two
# login budgets; failed attempts are limited by both IP and normalized account.
RATE_LIMIT_AUTH_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_LOGIN_MAX=30
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_ACCOUNT_MAX=10
RATE_LIMIT_AUTH_EMAIL_WINDOW_HOURS=1
RATE_LIMIT_AUTH_EMAIL_MAX=10
RATE_LIMIT_AUTH_FLOW_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_FLOW_MAX=30
RATE_LIMIT_AUTH_MFA_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MFA_MAX=20

# Upload-session control and status-polling throttles. Invalid or missing values
# fall back to these defaults. The create limit is also enforced in Postgres.
RATE_LIMIT_UPLOAD_SESSION_MUTATION_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_SESSION_MUTATION_MAX=300
RATE_LIMIT_UPLOAD_SESSION_POLL_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_SESSION_POLL_MAX=3000
RATE_LIMIT_UPLOAD_SESSION_CREATE_MAX_PER_HOUR=50

# Background upload processing. Each backend replica may process this many jobs
# concurrently, while the per-user cap prevents one large batch from occupying
# the entire pool. Invalid values use these defaults; concurrency is capped at
# 64 and the per-user value cannot exceed the process-wide concurrency.
UPLOAD_PROCESSING_CONCURRENCY=16
UPLOAD_PROCESSING_MAX_RUNNING_PER_USER=4

# Local Supabase CLI Google OAuth credentials. Google is enabled by default;
# set [auth.external.google].enabled to false to opt out locally.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Optional browser-reachable endpoint used only when signing direct-upload
# URLs. Required when R2_ENDPOINT_URL is an internal Docker hostname.
R2_PUBLIC_ENDPOINT_URL=
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

# Workflow ingestion source. The sync job resolves this ref to a commit before
# downloading. Pin a 40-character commit SHA for reproducible production
# releases. A token is only needed for private repositories or higher API limits.
MIKE_WORKFLOWS_REPOSITORY=Open-Legal-Products/mike-workflows
MIKE_WORKFLOWS_REF=main
MIKE_WORKFLOWS_GITHUB_TOKEN=

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional router keys. Users can also save any of these in Settings.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
OPENCODE_API_KEY=
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# Optional: enables higher-rate CourtListener case law/citation lookup tools.
COURTLISTENER_API_TOKEN=your-courtlistener-token

# Optional: Ed25519 seed used to sign project export manifests, so a recipient
# can tell an untouched manifest from an edited one. Leave it unset to export
# unsigned manifests: the file hashes are still there, the manifest itself is
# just unattested.
# Generate with: openssl rand -hex 32
# Use a dedicated secret. The matching public key is served at
# GET /manifest-signing-key. Rotating the key does not invalidate past exports,
# but whoever checks one needs the key that was current when it was made.
MANIFEST_SIGNING_KEY=
