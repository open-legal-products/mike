{
  "name": "mike-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.cjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:contracts": "tsc -p ../packages/contracts/tsconfig.json",
    "prestart": "node scripts/check-node-version.cjs",
    "start": "node --enable-source-maps dist/index.js",
    "sync:workflows": "node dist/jobs/syncWorkflows.js",
    "test": "vitest run",
    "test:stack": "bash scripts/test-stack.sh",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "backfill:document-text": "node dist/jobs/backfillDocumentText.js"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.134",
    "@ai-sdk/anthropic": "^4.0.98",
    "@ai-sdk/azure": "^4.0.118",
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/google-vertex": "^5.0.133",
    "@ai-sdk/mistral": "^4.0.80",
    "@ai-sdk/openai": "^4.0.77",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/xai": "^5.0.39",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@sentry/node": "11.11.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.164",
    "bullmq": "^6.7.1",
    "cors": "^2.8.5",
    "defuddle": "^0.19.6",
    "docx": "^9.15.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "fast-xml-parser": "^5.12.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.1.0",
    "html-to-text": "10.0.1",
    "ioredis": "^6.0.0",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.2",
    "libreoffice-convert": "^1.9.1",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "undici": "^8.12.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@babel/types": "^8.0.8",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "9.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "semver": "^7.8.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  },
  "license": "AGPL-3.0-only"
}
