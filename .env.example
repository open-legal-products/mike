# Root env for Docker Compose. Browser auth is handled by the backend and no
# Supabase key or API origin is baked into the frontend bundle.
#
# Defaults below are the stable demo keys printed by `supabase start`. If your
# local `supabase status` shows different values, paste them here.

SUPABASE_PUBLIC_URL=http://localhost:54321
API_BASE_URL=http://backend:3001

# Which Mike images Compose runs (docs/deployment.md "Running the published
# images"). The default tag is the version in /VERSION; pin a release here and
# `docker compose pull && docker compose up --no-build -d`. `docker compose up
# --build` ignores the registry and builds from this checkout instead.
MIKE_IMAGE_REPO=ghcr.io/open-legal-products
MIKE_IMAGE_TAG=
# Local Compose uses HTTP. Set NODE_ENV=production only with HTTPS public URLs.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
# Keep false anywhere other people can sign up: grants and organization
# invitations are matched by email, so autoconfirm lets anyone claim an
# address they do not own. Locally, confirmation mail lands in Mailpit
# (http://localhost:8025).
GOTRUE_MAILER_AUTOCONFIRM=false

# Google OAuth for the Docker Compose Auth service. The Google client must
# allow http://localhost:54321/auth/v1/callback (or the callback matching
# SUPABASE_PUBLIC_URL). Set this to false to opt out locally.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# Local Supabase anon key (well-known CLI default):
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Set both values for a deployed Word add-in. Generate a dedicated handoff key
# with `openssl rand -hex 32`; do not reuse a Supabase or signing secret.
WORD_ADDIN_URL=
AUTH_HANDOFF_ENCRYPTION_SECRET=

# Error reporting is ON BY DEFAULT and goes to the Mike project's own Sentry
# (see README "Telemetry" and docs/observability.md): never document text,
# bodies, cookies, auth headers or emails, and on a community install no
# machine name, user id, headers, breadcrumbs or file paths either. Opt out
# with SENTRY_DISABLED=true: the backend and the Next server read it at
# runtime, and the Next server applies it to the browser's reports too (they
# all pass through it), so it works for pulled images without a rebuild. To
# use your own Sentry, set SENTRY_DSN (backend) and FRONTEND_SENTRY_DSN (web
# app: the Next server forwards browser reports to it at runtime).
# An explicit value here always wins over an image's baked default, including
# a fork image published with reporting off: its operators set true.
SENTRY_DISABLED=false
SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Commit the images are built from; the Sentry release when SENTRY_RELEASE is
# empty. To enable source-map upload, set the switch to 1 and the org/project.
# Export/inject SENTRY_AUTH_TOKEN into the Compose process separately; putting
# it only in this .env is not reliable with all Compose/Bake versions. The token
# stays a build secret (see docs/observability.md, "Readable stack traces").
# Release identity for images you build yourself (published images already
# carry theirs): MIKE_VERSION=$(cat VERSION) GIT_SHA=$(git rev-parse HEAD)
# gives mike@<version>+<sha12>; without them a build is mike@0.0.0.
# Leave these commented when using published images so env_file preserves
# their baked release identity. Uncomment and set values for your own build.
# MIKE_VERSION=
# GIT_SHA=
SENTRY_UPLOAD_ENABLED=0
SENTRY_ORG=
SENTRY_PROJECT=
